# ===============================================
# File Nexus Suite -- .gitignore (Private Backup)
# ===============================================

# -- Python cache and compiled files --
__pycache__/
*.py[cod]
*$py.class
*.so

# -- Virtual environments --
venv/
.venv/
env/
ENV/

# -- PyInstaller build artifacts --
build/
dist/
*.spec.bak
*.manifest
*.zip

# -- App-generated runtime files --
FileNexusSuite.json
logs/
Output/
_internal/

# -- IDE / editor settings --
.vscode/
.idea/
*.swp
*.swo
*~

# -- OS-generated files --
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# -- Distribution / packaging --
*.egg-info/
*.egg
MANIFEST

# -- Temporary files --
*.tmp
*.temp
*.log
*~
*.md.bak
_msg*.txt